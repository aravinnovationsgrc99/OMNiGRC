{
  "name": "omnigrc-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:packages": "pnpm --filter \"@omnigrc/types\" build && pnpm --filter \"@omnigrc/shared\" build",
    "build": "pnpm build:packages && pnpm --filter \"@omnigrc/api\" build && pnpm --filter \"@omnigrc/web\" build",
    "dev": "pnpm build:packages && pnpm --parallel --recursive run dev",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm build:packages && pnpm --recursive run typecheck",
    "test": "pnpm build:packages && pnpm --recursive run test"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
